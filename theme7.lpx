#!name=Theme7签到
#!desc=Theme7每日签到，
#!author=〈ザㄩメ火华
#!icon= https://raw.githubusercontent.com/yuhuohua/tupiao/refs/heads/main/theme7.png
#!tag=〈ザㄩメ火华
#!arguments-desc=CRON定时设置: 签到脚本的 CRON 表达式; Token获取开关: 填写 # 即可禁用Token捕获

[Argument]
CRON定时设置=input,"0 9 * * *",tag=CRON定时设置, desc=CRON定时设置
TokenSwitch = input, "", tag=Token获取开关, desc=留空打开，填#关闭

[Script]
{TokenSwitch}http-request ^https:\/\/theme7.cn\/api\/v1\/public\/oauth\/profile script-path=https://raw.githubusercontent.com/yuhuohua/jb/refs/heads/main/theme7tk.js, requires-body=0, max-size=0, tag=Theme7获取

cron {CRON定时设置} script-path=https://raw.githubusercontent.com/yuhuohua/jb/refs/heads/main/theme7.js, tag=Theme7签到


[MITM]
hostname = theme7.cn