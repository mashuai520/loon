#!name=Theme7签到
#!desc=Theme7每日签到，支持多账号签到
#!author=〈ザㄩメ火华
#!icon=https://raw.githubusercontent.com/yuhuohua/tupiao/refs/heads/main/Theme7.PNG
#!tag=〈ザㄩメ火华

[Argument]
Token获取开关 = switch, true, true, tag = 抓取Token开关, desc = 默认开启。抓取Token成功后, 可关闭此开关

CRON定时设置 = input, "0 9 * * *", tag = CRON定时设置, desc = CRON定时设置

[Script]
http-response ^https:\/\/theme7.cn\/api\/v1\/public\/oauth\/profile script-path= https://raw.githubusercontent.com/yuhuohua/jb/refs/heads/main/theme7tk.js, requires-body=true, timeout=60, tag= Theme7token获取, enable = {Token获取开关}

cron {CRON定时设置} script-path= https://raw.githubusercontent.com/yuhuohua/jb/refs/heads/main/theme7.js, timeout=60, tag= Theme7签到