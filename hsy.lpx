[Argument]
CRON定时设置=input,35 7,18 * * *,tag=CRON定时设置, desc=CRON定时设置
抓取开关 = switch, true, true, tag = 抓取Token开关, desc = 默认开启。抓取Token成功后, 可关闭此开关

[Script]
http-response ^https?:\/\/www\.52bjy\.com\/api\/app\/.*(appkey=1079fb245839e765|hsy\.php).*username script-path=https://raw.githubusercontent.com/yuhuohua/jb/refs/heads/main/hsy.js, requires-body=true, timeout=60, tag=回收猿token捕获, enable={抓取开关}

cron {CRON定时设置} script-path=hsy.js, timeout=300, tag=回收猿_定时任务

[MITM]
hostname = www.52bjy.com