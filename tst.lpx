#!name=塔斯汀每日签到
#!desc=每日签到领积分，七天领一个小汉堡
#!author=〈ザㄩメ火华
#!icon=https://raw.githubusercontent.com/yuhuohua/tupiao/refs/heads/main/tst.png
#!arguments-desc=CRON定时设置: 签到脚本的 CRON 表达式

[Argument]
CRON定时设置=input,0 9 * * *,tag=CRON定时设置, desc=CRON定时设置
token= switch, true, true, tag = 抓取Token开关, desc = 默认开启。抓取Token成功后, 可关闭此开关

[Script]
http-request ^https:\/\/sss-web\.tastientech\.com\/api\/ script-path=https://raw.githubusercontent.com/yuhuohua/jb/refs/heads/main/tastien_token.js, enable = {token}

cron {CRON定时设置} script-path=https://raw.githubusercontent.com/yuhuohua/jb/refs/heads/main/tastien.js, timeout=30, tag=塔斯汀签到

[MITM]
hostname = sss-web.tastientech.com
