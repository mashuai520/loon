#!name=仰韶会员俱乐部签到
#!desc=自动获取仰韶会员小程序 Token，并在每天自动签到和查询积分。
#!category=每日签到
#!author=〈ザㄩメ火华

[Argument]
CRON定时设置 = input, "20 12 * * *", tag=CRON定时设置, desc=签到脚本的 CRON 表达式
抓取开关 = switch, true, true, tag=抓取Token开关, desc=默认开启。抓取Token成功后，可关闭此开关

[Script]
http-request ^https:\/\/hy\.51pt\.top\/ script-path=https://raw.githubusercontent.com/yuhuohua/jb/refs/heads/main/yshy.js, tag=仰韶_获取Token, requires-body=false, enable={抓取开关}

cron {CRON定时设置} script-path=https://raw.githubusercontent.com/yuhuohua/jb/refs/heads/main/yshy.js, tag=仰韶_自动签到, timeout=60

[MITM]
hostname = hy.51pt.top
